<?xml version="1.0" encoding="UTF-8"?>
<!--
  AppStream metainfo (Hearth phase A7) - what puts hearth in a Linux
  desktop's own application menu/software centre, alongside
  com.iainchesworthlabs.hearth.desktop (the entry itself) and
  apps/forge/gui/packaging/linux/forge-gui-mime.xml (the audio/ac3,
  audio/eac3 types it opens - the same shared-mime-info fragment forge-gui
  installed first; declaring the same glob twice would conflict, so this
  component reuses it rather than shipping its own copy). <id> is the
  .desktop file's basename without the suffix, and the launchable names the
  file: AppStream requires that to associate the two. The id follows the
  repository's account, as the macOS bundle id does; it was hearth.desktop
  before any release carried it.
-->
<component type="desktop-application">
  <id>com.iainchesworthlabs.hearth</id>
  <name>hearth</name>
  <summary>Play AC-3, E-AC-3 and AC-4 streams on speakers, a receiver or a Sendspin network</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <description>
    <p>
      hearth is the ICL Forge desktop player. It plays AC-3, E-AC-3 (with Dolby Atmos
      objects) and AC-4 (channel-based, immersive and object content), decodes to a chosen
      speaker layout with each format's decoder settings, and plays to a local device or to a
      group of Sendspin network sinks. AC-3 and E-AC-3 streams can also be sent to a receiver
      over HDMI or S/PDIF as a bitstream. In a group, the ESP32 sinks take AC-3 and E-AC-3
      only.
    </p>
  </description>
  <launchable type="desktop-id">com.iainchesworthlabs.hearth.desktop</launchable>
  <url type="homepage">https://github.com/iainchesworthlabs/iclforge</url>
  <provides>
    <binary>hearth</binary>
    <mediatype>audio/ac3</mediatype>
    <mediatype>audio/eac3</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
</component>
