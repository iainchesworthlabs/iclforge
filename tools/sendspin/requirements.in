# Input for requirements.txt, a pip-compile --generate-hashes lock that _ci-core.yml installs with
# --require-hashes. Regenerate the lock after any change here with:
#   python -m piptools compile --generate-hashes --strip-extras \
#     --output-file=requirements.txt requirements.in
# The lock is compiled under Python 3.14 and installed by CI under whatever python3 ubuntu-latest
# ships (3.12). The two resolve to the same set today: aiohttp and aiosignal want typing-extensions
# below 3.13, and mashumaro already brings it in. If a bump adds a python_version-gated
# dependency, compile under 3.12 (--require-hashes fails on a package the lock leaves out).
#
# The scripts in tools/sendspin, on Python 3.12 or later: aiosendspin 9.1.1, PyAV for its FLAC
# and Opus codecs, and numpy and Pillow, which its server half imports (aiosendspin_server.py).
aiosendspin==9.1.1
av==19.0.1
numpy==2.5.4
pillow==13.0.0

# Not imported directly. aiosendspin 9.1.1 (still the latest release as of 2026-09-23) declares
# only aiohttp>=3.9.2 with no upper bound, so an unpinned install can resolve to old aiohttp/idna
# builds carrying dozens of disclosed CVEs (osv-scanner alerts, GHSA-mq44-7p77-q5h7 and friends).
# Pinned here to versions aiosendspin's own constraint already permits, past every known advisory.
aiohttp==3.14.5
idna==3.20
