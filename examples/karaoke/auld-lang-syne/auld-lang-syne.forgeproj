{
  "format": "iclforge-project",
  "version": 1,
  "title": "Auld Lang Syne (karaoke example)",
  "flow": "karaoke",
  "sources": [
    {
      "path": "parts/backing.wav",
      "part": "backing"
    },
    {
      "path": "parts/melody-guide.wav",
      "part": "melody"
    },
    {
      "path": "parts/vocal-1-lead.wav",
      "part": "vocal1"
    },
    {
      "path": "parts/vocal-2-harmony.wav",
      "part": "vocal2"
    }
  ],
  "bed": "3/2",
  "lfe": false,
  "assignments": [
    {
      "source": 0,
      "channel": 0,
      "to": "L"
    },
    {
      "source": 0,
      "channel": 1,
      "to": "R"
    },
    {
      "source": 1,
      "channel": 0,
      "to": "C"
    },
    {
      "source": 2,
      "channel": 0,
      "to": "Ls"
    },
    {
      "source": 3,
      "channel": 0,
      "to": "Rs"
    }
  ],
  "encode": {
    "codec": "ac3",
    "container": "elementary",
    "bitrateKbps": 384,
    "options": {
      "bsmod": "voiceover"
    }
  },
  "karaoke": {
    "input": "parts",
    "listening": "aware",
    "vocals": "both"
  }
}
