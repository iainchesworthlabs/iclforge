# The Hearth S3 boards: 240 MHz and octal PSRAM at 80 MHz (firmware/hearth-sink/sdkconfig.psram), so
# the bench can time a message that lives in PSRAM as well as one in internal RAM.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MEMTEST=n
